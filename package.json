{
  "name": "framepack",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "main": "./dist/cli.js",
  "bin": {
    "framepack": "./dist/cli.js"
  },
  "description": "An agent-native video project compiler that turns content into executable video project packages.",
  "files": [
    "dist",
    "examples",
    "README.md",
    "AGENTS.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "video",
    "agent",
    "hyperframes",
    "compiler",
    "cli",
    "automation"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node scripts/run-tests.mjs",
    "test:watch": "npm run build && node --watch scripts/run-tests.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "hyperframes": "^0.4.12"
  }
}
