{
  "name": "framepack",
  "version": "0.4.0-beta.1",
  "private": false,
  "type": "module",
  "main": "./dist/cli.js",
  "bin": {
    "framepack": "dist/cli.js"
  },
  "description": "An agent-native video project compiler that turns content into executable video project packages.",
  "files": [
    "dist",
    "examples",
    "README.md",
    "README.zh-CN.md",
    "AGENTS.md",
    "docs/architecture",
    "docs/agent-platform",
    "templates",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "video",
    "agent",
    "hyperframes",
    "compiler",
    "cli",
    "automation"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "release:gate": "node scripts/run-release-gate.mjs",
    "release:scenarios": "npm run build && node scripts/run-real-scenarios.mjs",
    "release:smoke:install": "npm run build && node scripts/run-install-smoke.mjs",
    "test": "npm run build && node scripts/run-tests.mjs",
    "test:watch": "npm run build && node --watch scripts/run-tests.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "hyperframes": "^0.6.40",
    "zod": "^4.4.3"
  }
}
